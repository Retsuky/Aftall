{
  "name": "Aftall",
  "displayName": "; after every line",
  "description": "Now ; will be after every line",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
  "type": "git",
  "url": "https://github.com/Retsuky/Aftall.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "Aftall",
      "title": "; every line"
    }],
    "keybindings": {
      "command": "Aftall",
      "key": "enter",
      "when": "editorTextFocus"
    }

  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.16.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
    
  }
}
